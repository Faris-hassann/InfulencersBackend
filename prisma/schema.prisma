generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id Int @id @default(autoincrement())
  email String @unique @db.VarChar(254)
  passwordHash String @db.VarChar(512)
  role String @default("admin") @db.VarChar(32)
  enabled Boolean @default(true)
  createdOn DateTime @default(now()) @db.Timestamptz(3)
  sessions AdminSession[]
  @@map("admins")
}

model AdminSession {
  tokenHash String @id @db.VarChar(64)
  adminId Int
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresOn DateTime @db.Timestamptz(3)
  createdOn DateTime @default(now()) @db.Timestamptz(3)
  @@index([adminId])
  @@index([expiresOn])
  @@map("admin_sessions")
}

model Book {
  id Int @id @default(autoincrement())
  title String @db.VarChar(250)
  titleAr String? @db.VarChar(250)
  description String @db.Text
  descriptionAr String? @db.Text
  imageUrl String @db.VarChar(2048)
  youtubeUrl String? @db.VarChar(2048)
  publishedOn DateTime @db.Timestamptz(3)
  @@index([publishedOn, id])
  @@map("books")
}

model Podcast {
  id Int @id @default(autoincrement())
  title String @db.VarChar(250)
  titleAr String? @db.VarChar(250)
  description String @db.Text
  descriptionAr String? @db.Text
  imageUrl String @db.VarChar(2048)
  youtubeUrl String? @db.VarChar(2048)
  publishedOn DateTime @db.Timestamptz(3)
  @@index([publishedOn, id])
  @@map("podcasts")
}

model Tip {
  id Int @id @default(autoincrement())
  title String @db.VarChar(250)
  titleAr String? @db.VarChar(250)
  description String @db.Text
  descriptionAr String? @db.Text
  imageUrl String @db.VarChar(2048)
  youtubeUrl String? @db.VarChar(2048)
  publishedOn DateTime @db.Timestamptz(3)
  @@index([publishedOn, id])
  @@map("tips_and_tricks")
}

model News {
  id Int @id @default(autoincrement())
  title String @db.VarChar(250)
  titleAr String? @db.VarChar(250)
  description String @db.Text
  descriptionAr String? @db.Text
  imageUrl String @db.VarChar(2048)
  youtubeUrl String? @db.VarChar(2048)
  publishedOn DateTime @db.Timestamptz(3)
  @@index([publishedOn, id])
  @@map("news")
}

model Newsletter {
  id Int @id @default(autoincrement())
  title String @db.VarChar(250)
  titleAr String? @db.VarChar(250)
  description String @db.Text
  descriptionAr String? @db.Text
  imageUrl String @db.VarChar(2048)
  youtubeUrl String? @db.VarChar(2048)
  publishedOn DateTime @db.Timestamptz(3)
  @@index([publishedOn, id])
  @@map("newsletters")
}

model Contact {
  id Int @id @default(autoincrement())
  firstName String @db.VarChar(100)
  firstNameAr String? @db.VarChar(100)
  lastName String @db.VarChar(100)
  lastNameAr String? @db.VarChar(100)
  description String @db.Text
  descriptionAr String? @db.Text
  email String @db.VarChar(254)
  phoneNumber String @db.VarChar(32)
  createdOn DateTime @default(now()) @db.Timestamptz(3)
  @@index([createdOn, id])
  @@map("contacts")
}

model ArticleCategory {
  id Int @id @default(autoincrement())
  nameEn String @db.VarChar(250)
  nameAr String @db.VarChar(250)
  descriptionEn String @db.Text
  descriptionAr String @db.Text
  createdOn DateTime @default(now()) @db.Timestamptz(3)
  articles Article[]
  @@index([createdOn, id])
  @@map("article_categories")
}

model Article {
  id Int @id @default(autoincrement())
  titleEn String @db.VarChar(250)
  titleAr String @db.VarChar(250)
  descriptionEn String @db.Text
  descriptionAr String @db.Text
  articleCategoryId Int?
  articleCategory ArticleCategory? @relation(fields: [articleCategoryId], references: [id], onDelete: SetNull)
  imageUrls String[] @default([])
  publishedOn DateTime @default(now()) @db.Timestamptz(3)
  @@index([publishedOn, id])
  @@index([articleCategoryId])
  @@map("articles")
}

model Award {
  id Int @id @default(autoincrement())
  titleEn String @db.VarChar(250)
  titleAr String @db.VarChar(250)
  descriptionEn String @db.Text
  descriptionAr String @db.Text
  imageUrls String[] @default([])
  publishedOn DateTime @default(now()) @db.Timestamptz(3)
  @@index([publishedOn, id])
  @@map("awards")
}
